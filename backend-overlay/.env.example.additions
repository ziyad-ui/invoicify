# ---- Add / change these in the .env that Laravel generated ----
APP_NAME=Invoicify
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

# The React app's origin (comma-separate multiple origins)
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invoicify
DB_USERNAME=root
DB_PASSWORD=

# Emails are only WRITTEN TO storage/logs/laravel.log while MAIL_MAILER=log (fine for development).
# For real delivery, use SMTP (example: Gmail app password / your hosting's SMTP):
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=loverealty@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="billing@loverealty.com"
MAIL_FROM_NAME="Love Realty"

# Notification timing (optional, these are the defaults)
INVOICIFY_DUE_SOON_DAYS=7
INVOICIFY_REMINDER_DAYS=3
INVOICIFY_OVERDUE_REPEAT_DAYS=7
