# Used automatically by `php artisan test`, so tests never touch your real MySQL database.
# Requires the pdo_sqlite PHP extension (XAMPP: enable `extension=pdo_sqlite` in php.ini).
APP_ENV=testing
APP_KEY=base64:dGVzdGluZy1rZXktdGVzdGluZy1rZXktMTIzNDU2Nzg=
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
MAIL_MAILER=array
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=4
