APP_NAME="Love Realty Invoicify"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://api.yourdomain.com

# The address of the website (frontend) - used for CORS. No trailing slash.
FRONTEND_URL=https://invoices.yourdomain.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invoicify
DB_USERNAME=invoicify
DB_PASSWORD=change-me

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ---- Email ----------------------------------------------------------------
# OPTION A - Gmail (fine to start; about 500 emails/day on a personal account).
# Use a Google "App Password", not your normal password.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourbusiness@gmail.com
MAIL_PASSWORD=your16characterapppassword
MAIL_FROM_ADDRESS=yourbusiness@gmail.com
MAIL_FROM_NAME="Love Realty"
INVOICIFY_DAILY_EMAIL_LIMIT=450

# OPTION B - Brevo (free: 300/day, better delivery; verify your domain first). Comment out
# option A above and use these instead - see DEPLOYMENT.md "Email delivery":
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=<SMTP login shown on Brevo's SMTP & API page>
# MAIL_PASSWORD=<Brevo SMTP key (not the API key)>
# MAIL_FROM_ADDRESS=billing@yourdomain.com
# MAIL_FROM_NAME="Love Realty"
# INVOICIFY_DAILY_EMAIL_LIMIT=280

# ---- First owner login (used once by: php artisan db:seed --force) ----
OWNER_NAME="Marivic D. Juan"
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=choose-a-long-password-with-numbers-1

# ---- Reminder rules ----
INVOICIFY_DUE_SOON_DAYS=7
INVOICIFY_REMINDER_DAYS=3
INVOICIFY_OVERDUE_REPEAT_DAYS=7
